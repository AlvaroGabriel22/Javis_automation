POSTGRES_USER=jarvis
POSTGRES_DB=jarvis
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_PASSWORD=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=45

# Nome usado nos recados quando o cadastro local ainda se chama “Proprietário”.
JARVIS_DEFAULT_OWNER_NAME=Álvaro

# Conversa e interpretação. Para usar a nuvem, selecione groq ou openai e preencha o modelo e a chave.
JARVIS_CHAT_PROVIDER=ollama
OLLAMA_VISION_MODEL=qwen3-vl:2b
GROQ_MODEL=
OPENAI_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=

# Busca pública. Para Brave, selecione brave e informe sua chave.
JARVIS_SEARCH_PROVIDER=searxng
JARVIS_SEARXNG_URL=http://127.0.0.1:8888
BRAVE_SEARCH_API_KEY=

# Planilha Google dedicada ao vínculo. Ative o envio pelo painel.
JARVIS_GOOGLE_SHEETS_ID=
JARVIS_GOOGLE_SHEETS_CREDENTIALS=
